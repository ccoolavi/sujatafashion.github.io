# Sujata Fashion Backend Configuration

# App Settings
SFA_APP_NAME=Sujata Fashion Backend
SFA_APP_VERSION=1.0.0
SFA_DEBUG=True

# Server Settings
SFA_SERVER_HOST=0.0.0.0
SFA_SERVER_PORT=8000
SFA_SERVER_RELOAD=True

# Database Settings
SFA_DB_PATH=backend/data/sujata.db

# Auth Settings
SFA_SECRET_KEY=your_secret_key_here
SFA_AUTH_ALGORITHM=HS256
SFA_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Settings
SFA_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Cloudinary Settings
SFA_CLOUDINARY_CLOUD_NAME=your_cloud_name
SFA_CLOUDINARY_API_KEY=your_api_key
SFA_CLOUDINARY_API_SECRET=your_api_secret
